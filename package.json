{
  "name": "maisjiu",
  "version": "0.1.0",
  "private": true,
  "description": "Mais Jiu — app de retenção e estudo para Jiu-Jitsu",
  "scripts": {
    "test": "jest tests/unit tests/integration --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:app": "cd app && bun run test",
    "test:app:integration": "cd app && bun run test:integration",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:app"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
